olor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2696" y="2164" width="130" height="30" as="geometry"/></mxCell><mxCell id="c238" value="FAIL" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="2834" y="2164" width="130" height="30" as="geometry"/></mxCell><mxCell id="c239" value="🎉 character on the far cliff&lt;br&gt;(or 🪁 kite in the clouds)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="2696" y="2206" width="268" height="120" as="geometry"/></mxCell><mxCell id="c240" value="You crossed the bridge!" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="2696" y="2338" width="268" height="30" as="geometry"/></mxCell><mxCell id="c241" value="Fail: 'Almost! Let's try again 💪'" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2696" y="2368" width="268" height="22" as="geometry"/></mxCell><mxCell id="c242" value="&amp;lt;b&amp;gt;8 / 10&amp;lt;/b&amp;gt; right  ·  ⭐⭐⭐" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="2696" y="2400" width="268" height="44" as="geometry"/></mxCell><mxCell id="c243" value="&amp;lt;b&amp;gt;Review these&amp;lt;/b&amp;gt;&lt;br&gt;receipt · appointment" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x