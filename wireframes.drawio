mxCell><mxCell id="c260" value="Quiz orally" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A13D3D;strokeWidth=2;fontColor=#241C10;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c81" target="c210"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c261" value="Quiz normally" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A13D3D;strokeWidth=2;fontColor=#241C10;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c81" target="c221"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c262" value="first time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A13D3D;strokeWidth=2;fontColor=#241C10;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c201" target="c210"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c263" value="Quiz me" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A13D3D;strokeWidth=2;fontColor=#241C10;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#888888;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c189" target="c234"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c264" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A13D3D;strokeWidth=2;fontColor=#241C10;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;strokeColor=#888888;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c210" target="c221"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c265" value="win / fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A13D3D;strokeWidth=2;fontColor=#241C10;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c221" target="c234"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c266" value="&amp;lt;b style='font-size:26px'&amp;gt;Maatalu · Page flow wireframes&amp;lt;/b&amp;gt;  &amp;lt;span style='font-size:14px'&amp;gt;(phone-first · theme from frontend/style.css · 2026-11-20)&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1700" height="60" as="geometry"/></mxCell><mxCell id="c267" value="&amp;lt;b&amp;gt;Red arrows&amp;lt;/b&amp;gt; = main flow · &amp;lt;b&amp;gt;gray dashed&amp;lt;/b&amp;gt; = alternate path or shared page (both learn modes → Lesson complete; both games → Result; Mic check comes before any oral mode).&lt;br&gt;The yellow notes under each screen explain the rules and the backend piece behind it. Drag screens around freely: arrows stay attached." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;align=left;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1700" height="90" as="geometry"/></mxCell><mxCell id="c268" value="&amp;lt;b style='font-size:16px'&amp;gt;Open decisions&amp;lt;/b&amp;gt;&lt;br&gt;&lt;br&gt;1. &amp;lt;b&amp;gt;Recovery phone:&amp;lt;/b&amp;gt; needs paid SMS (Twilio etc.). Start email-only?&lt;br&gt;&lt;br&gt;2. &amp;lt;b&amp;gt;Google sign-in:&amp;lt;/b&amp;gt; one tap is easiest for mom. Add it? (Free in Supabase.)&lt;br&gt;&lt;br&gt;3. &amp;lt;b&amp;gt;Free AI conversation:&amp;lt;/b&amp;gt; placed as the last step of each oral lesson. OK, or its own tile later?&lt;br&gt;&lt;br&gt;4. &amp;lt;b&amp;gt;Kite pass mark:&amp;lt;/b&amp;gt; pronunciation score ≥ 70 to climb. Tune after mom tries it.&lt;br&gt;&lt;br&gt;5. &amp;lt;b&amp;gt;60 s timer:&amp;lt;/b&amp;gt; per question (resets each time), not for the whole quiz.&lt;br&gt;&lt;br&gt;6. &amp;lt;b&amp;gt;Landing on phone:&amp;lt;/b&amp;gt; video above Get started (side by side only on a laptop).&lt;br&gt;&lt;br&gt;&amp;lt;b style='font-size:16px'&amp;gt;Later, not v1&amp;lt;/b&amp;gt;&lt;br&gt;Daily reminder · Sankranti/festival themed lesson packs · more game types · family view (you can see mom's progress)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#A13D3D;strokeWidth=2;fontColor=#241C10;align=left;verticalAlign=top;spacing=16;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="2140" width="740" height="600" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="browser" name="Browser (laptop)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#F4EEE2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c269" value="1 · Landing (scrolls)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="880" height="28" as="geometry"/></mxCell><mxCell id="c270" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=2;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="880" height="1860" as="geometry"/></mxCell><mxCell id="c271" value="&amp;lt;span style='color:#C0504D'&amp;gt;●&amp;lt;/span&amp;gt; &amp;lt;span style='color:#E3A008'&amp;gt;●&amp;lt;/span&amp;gt; &amp;lt;span style='color:#4C7A5A'&amp;gt;●&amp;lt;/span&amp;gt;      🔒 maatalu.app" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E9E2D3;strokeColor=#241C10;fontColor=#4A4030;align=left;spacingLeft=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="880" height="30" as="geometry"/></mxCell><mxCell id="c272" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="880" height="6" as="geometry"/></mxCell><mxCell id="c273" value="A long page that scrolls. The first screen shows the hero (video + Get started); 'What you can do' begins at the fold. Each mode is a full-width band, with the picture alternating left and right.&lt;br&gt;The top-bar links 'How it works' and 'Accents' scroll down this same page." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="2128" width="880" height="100" as="geometry"/></mxCell><mxCell id="c274" value="&amp;lt;b style='font-size:15px'&amp;gt;మాటలు&amp;lt;/b&amp;gt; Maatalu" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="72" y="308" width="333" height="34" as="geometry"/></mxCell><mxCell id="c275" value="How it works" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="415" y="308" width="111" height="34" as="geometry"/></mxCell><mxCell id="c276" value="Accents" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="536" y="308" width="111" height="34" as="geometry"/></mxCell><mxCell id="c277" value="Log in" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="657" y="308" width="111" height="34" as="geometry"/></mxCell><mxCell id="c278" value="Sign up" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="778" y="308" width="111" height="34" as="geometry"/></mxCell><mxCell id="c279" value="▶&lt;br&gt;Demo video&lt;br&gt;(how the app works, about 1 min)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="72" y="360" width="470" height="300" as="geometry"/></mxCell><mxCell id="c280" value="Learn everyday English, explained in Telugu" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;fontSize=20;" vertex="1" parent="1"><mxGeometry x="570" y="390" width="318" height="64" as="geometry"/></mxCell><mxCell id="c281" value="రోజువారీ ఇంగ్లీష్, తెలుగులో నేర్చుకోండి" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="456" width="318" height="20" as="geometry"/></mxCell><mxCell id="c282" value="Speak or tap, at your own pace. A Telugu voice guides every step." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="570" y="484" width="318" height="40" as="geometry"/></mxCell><mxCell id="c283" value="Get started →" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="536" width="318" height="48" as="geometry"/></mxCell><mxCell id="c284" value="Free · works on phone and laptop" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="570" y="590" width="318" height="18" as="geometry"/></mxCell><mxCell id="c285" value="&amp;lt;div style='text-align:center'&amp;gt;Scroll to see what you can do ↓&amp;lt;/div&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="72" y="696" width="816" height="18" as="geometry"/></mxCell><mxCell id="c286" value="What you can do" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;fontSize=22;" vertex="1" parent="1"><mxGeometry x="72" y="760" width="816" height="32" as="geometry"/></mxCell><mxCell id="c287" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="72" y="808" width="816" height="230" as="geometry"/></mxCell><mxCell id="c288" value="🎙&lt;br&gt;illustration: speaking into the phone,&lt;br&gt;words turning green" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="92" y="828" width="372" height="190" as="geometry"/></mxCell><mxCell id="c289" value="&amp;lt;span style='font-size:20px'&amp;gt;Learn by speaking&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:13px;font-weight:normal'&amp;gt;Hear a phrase in a US voice, say it back, and see a score for every word.&lt;br&gt;A Telugu voice explains each step.&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:12px'&amp;gt;Try it →&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;fontSize=15;fillColor=none;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="496" y="828" width="372" height="190" as="geometry"/></mxCell><mxCell id="c290" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#4C7A5A;strokeColor=none;fontColor=#F7EFDD;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="72" y="1058" width="816" height="230" as="geometry"/></mxCell><mxCell id="c291" value="📖&lt;br&gt;illustration: tapping words into order" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="496" y="1078" width="372" height="190" as="geometry"/></mxCell><mxCell id="c292" value="&amp;lt;span style='font-size:20px'&amp;gt;Learn by reading&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:13px;font-weight:normal'&amp;gt;The same lessons with no mic. Put words in order, pick the meaning, fill in blanks.&lt;br&gt;Good for quiet places.&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:12px'&amp;gt;Try it →&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#4C7A5A;strokeColor=none;fontColor=#F7EFDD;fontStyle=1;fontSize=15;fillColor=none;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="92" y="1078" width="372" height="190" as="geometry"/></mxCell><mxCell id="c293" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#A13D3D;strokeColor=none;fontColor=#F7EFDD;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="72" y="1308" width="816" height="230" as="geometry"/></mxCell><mxCell id="c294" value="🪁&lt;br&gt;illustration: kite climbing over rooftops" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="92" y="1328" width="372" height="190" as="geometry"/></mxCell><mxCell id="c295" value="&amp;lt;span style='font-size:20px'&amp;gt;Kite game (speak)&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:13px;font-weight:normal'&amp;gt;Say the word right and your kite flies higher.&lt;br&gt;Three misses and the string snaps.&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:12px'&amp;gt;Try it →&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#A13D3D;strokeColor=none;fontColor=#F7EFDD;fontStyle=1;fontSize=15;fillColor=none;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="496" y="1328" width="372" height="190" as="geometry"/></mxCell><mxCell id="c296" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#2E4470;strokeColor=#C9BFA6;fontColor=#F7EFDD;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="72" y="1558" width="816" height="230" as="geometry"/></mxCell><mxCell id="c297" value="🌉&lt;br&gt;illustration: character crossing a rope bridge" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="496" y="1578" width="372" height="190" as="geometry"/></mxCell><mxCell id="c298" value="&amp;lt;span style='font-size:20px'&amp;gt;Bridge game (tap)&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:13px;font-weight:normal'&amp;gt;Each right answer is one step across the bridge.&lt;br&gt;Three wrong answers or 60 seconds and you fall.&amp;lt;/span&amp;gt;&lt;br&gt;&lt;br&gt;&amp;lt;span style='font-size:12px'&amp;gt;Try it →&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#2E4470;strokeColor=#C9BFA6;fontColor=#F7EFDD;fontStyle=1;fontSize=15;fillColor=none;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="92" y="1578" width="372" height="190" as="geometry"/></mxCell><mxCell id="c299" value="7 English accents" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;fontSize=22;" vertex="1" parent="1"><mxGeometry x="72" y="1818" width="816" height="32" as="geometry"/></mxCell><mxCell id="c300" value="Click one to hear a sample 🔊 · switch any time in Settings" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="72" y="1852" width="816" height="18" as="geometry"/></mxCell><mxCell id="c301" value="🇺🇸 US" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="72" y="1890" width="110" height="48" as="geometry"/></mxCell><mxCell id="c302" value="🇬🇧 UK" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="190" y="1890" width="110" height="48" as="geometry"/></mxCell><mxCell id="c303" value="🇦🇺 Australia" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="308" y="1890" width="110" height="48" as="geometry"/></