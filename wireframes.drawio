" parent="1"><mxGeometry x="920" y="1808" width="300" height="120" as="geometry"/></mxCell><mxCell id="c137" value="← Back to log in" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936" y="1224" width="268" height="18" as="geometry"/></mxCell><mxCell id="c138" value="Reset your password" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="936" y="1250" width="268" height="30" as="geometry"/></mxCell><mxCell id="c139" value="Enter your email and we'll send you a link.&lt;br&gt;మీ ఈమెయిల్‌కి లింక్ పంపుతాము" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936" y="1286" width="268" height="40" as="geometry"/></mxCell><mxCell id="c140" value="Email" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#EFE4CD;strokeColor=#C9BFA6;fontColor=#4A4030;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="936" y="1342" width="268" height="36" as="geometry"/></mxCell><mxCell id="c141" value="Send reset link" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="936" y="1392" width="268" height="44" as="geometry"/></mxCell><mxCell id="c142" value="After sending:" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936" y="1466" width="268" height="16" as="geometry"/></mxCell><mxCell id="c143" value="✅  Check your email&lt;br&gt;The link works for 1 hour." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="936" y="1486" width="268" height="62" as="geometry"/></mxCell><mxCell id="c144" value="10 · Lesson path" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="1166" width="300" height="28" as="geometry"/></mxCell><mxCell id="c145" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1360" y="1200" width="300" height="600" as="geometry"/></mxCell><mxCell id="c146" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1360" y="1200" width="300" height="8" as="geometry"/></mxCell><mxCell id="c147" value="Built from the level-check answers. The old 'scenarios' become these lesson topics.&lt;br&gt;One path shared by both modes: a lesson finished orally also counts as done for 'normally'." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1360" y="1808" width="300" height="120" as="geometry"/></mxCell><mxCell id="c148" value="← Home" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1376" y="1224" width="76" height="30" as="geometry"/></mxCell><mxCell id="c149" value="🎙 Orally | 📖 Normally" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="1460" y="1224" width="184" height="30" as="geometry"/></mxCell><mxCell id="c150" value="Your lessons" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="1376" y="1264" width="268" height="28" as="geometry"/></mxCell><mxCell id="c151" value="✅  1 · Greetings" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="1376" y="1302" width="268" height="46" as="geometry"/></mxCell><mxCell id="c152" value="✅  2 · Numbers &amp;amp; money" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="1376" y="1356" width="268" height="46" as="geometry"/></mxCell><mxCell id="c153" value="▶  3 · At the market" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1376" y="1410" width="268" height="54" as="geometry"/></mxCell><mxCell id="c154" value="🔒  4 · At the doctor" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;opacity=60;" vertex="1" parent="1"><mxGeometry x="1376" y="1472" width="268" height="46" as="geometry"/></mxCell><mxCell id="c155" value="🔒  5 · Phone calls" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;opacity=60;" vertex="1" parent="1"><mxGeometry x="1376" y="1526" width="268" height="46" as="geometry"/></mxCell><mxCell id="c156" value="🔒  6 · Talking with grandkids" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;opacity=60;" vertex="1" parent="1"><mxGeometry x="1376" y="1580" width="268" height="46" as="geometry"/></mxCell><mxCell id="c157" value="🔒  7 · Bus &amp;amp; auto" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;opacity=60;" vertex="1" parent="1"><mxGeometry x="1376" y="1634" width="268" height="46" as="geometry"/></mxCell><mxCell id="c158" value="11 · Learn orally" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1800" y="1166" width="300" height="28" as="geometry"/></mxCell><mxCell id="c159" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1800" y="1200" width="300" height="600" as="geometry"/></mxCell><mxCell id="c160" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1800" y="1200" width="300" height="8" as="geometry"/></mxCell><mxCell id="c161" value="Azure TTS (Ava, US) for English and Diya for the Telugu guide. Pronunciation assessment colors each word.&lt;br&gt;The last step of a lesson is a short free chat with the AI (Gemini) on the topic: this is where 'free conversation' lives." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1800" y="1808" width="300" height="120" as="geometry"/></mxCell><mxCell id="c162" value="← 3 · At the market" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1816" y="1224" width="156" height="18" as="geometry"/></mxCell><mxCell id="c163" value="Step 2 of 8" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1980" y="1224" width="104" height="18" as="geometry"/></mxCell><mxCell id="c164" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=50;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1816" y="1246" width="268" height="6" as="geometry"/></mxCell><mxCell id="c165" value="🔊 'ఇది ఎంత?' అని అడగాలంటే ఇలా చెప్పండి&lt;br&gt;&amp;lt;i&amp;gt;To ask the price, say this&amp;lt;/i&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="1816" y="1264" width="268" height="62" as="geometry"/></mxCell><mxCell id="c166" value="&amp;lt;span style='font-size:20px;font-family:Georgia'&amp;gt;&amp;lt;b&amp;gt;How much is this?&amp;lt;/b&amp;gt;&amp;lt;/span&amp;gt;&lt;br&gt;🔊 Play    🐢 Slow" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1816" y="1336" width="268" height="92" as="geometry"/></mxCell><mxCell id="c167" value="🎙&lt;br&gt;Hold and say it" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;arcSize=50;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1816" y="1442" width="268" height="96" as="geometry"/></mxCell><mxCell id="c168" value="&amp;lt;span style='color:#4C7A5A'&amp;gt;How&amp;lt;/span&amp;gt; · &amp;lt;span style='color:#4C7A5A'&amp;gt;much&amp;lt;/span&amp;gt; · &amp;lt;span style='color:#E3A008'&amp;gt;is&amp;lt;/span&amp;gt; · &amp;lt;span style='color:#4C7A5A'&amp;gt;this&amp;lt;/span&amp;gt;   &amp;lt;b&amp;gt;86&amp;lt;/b&amp;gt;&lt;br&gt;&amp;lt;span style='font-size:10px'&amp;gt;'is' sounded like 'ees', try again 🔊&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1816" y="1552" width="268" height="62" as="geometry"/></mxCell><mxCell id="c169" value="Try again" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="1816" y="1626" width="108" height="40" as="geometry"/></mxCell><mxCell id="c170" value="Next" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1932" y="1626" width="152" height="40" as="geometry"/></mxCell><mxCell id="c171" value="12 · Learn normally" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="2240" y="1166" width="300" height="28" as="geometry"/></mxCell><mxCell id="c172" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2240" y="1200" width="300" height="600" as="geometry"/></mxCell><mxCell id="c173" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2240" y="1200" width="300" height="8" as="geometry"/></mxCell><mxCell id="c174" value="No mic, ever. Activities rotate: put words in order, pick the meaning, match Telugu ↔ English, fill in the blank.&lt;br&gt;Audio is optional, for headphones." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2240" y="1808" width="300" height="120" as="geometry"/></mxCell><mxCell id="c175" value="← 3 · At the market" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2256" y="1224" width="156" height="18" as="geometry"/></mxCell><mxCell id="c176" value="Step 2 of 8" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2420" y="1224" width="104" height="18" as="geometry"/></mxCell><mxCell id="c177" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=50;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2256" y="1246" width="268" height="6" as="geometry"/></mxCell><mxCell id="c178" value="'ఇది ఎంత?' అని అడగాలంటే ఇలా రాయండి&lt;br&gt;&amp;lt;i&amp;gt;To ask the price, write this&amp;lt;/i&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="2256" y="1264" width="268" height="58" as="geometry"/></mxCell><mxCell id="c179" value="&amp;lt;span style='font-size:18px;font-family:Georgia'&amp;gt;&amp;lt;b&amp;gt;How much is this?&amp;lt;/b&amp;gt;&amp;lt;/span&amp;gt;&lt;br&gt;🔊 optional (headphones)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="2256" y="1332" width="268" height="74" as="geometry"/></mxCell><mxCell id="c180" value="&amp;lt;b&amp;gt;Put the words in order:&amp;lt;/b&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="2256" y="1420" width="268" height="20" as="geometry"/></mxCell><mxCell id="c181" value="is" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="2256" y="1448" width="61" height="40" as="geometry"/></mxCell><mxCell id="c182" value="How" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="2325" y="1448" width="61" height="40" as="geometry"/></mxCell><mxCell id="c183" value="this?" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="2394" y="1448" width="61" height="40" as="geometry"/></mxCell><mxCell id="c184" value="much" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="2463" y="1448" width="61" height="40" as="geometry"/></mxCell><mxCell id="c185" value="How  much  ___  ___" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#EFE4CD;strokeColor=#C9BFA6;fontColor=#4A4030;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2256" y="1500" width="268" height="46" as="geometry"/></mxCell><mxCell id="c186" value="Check" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2256" y="1560" width="268" height="42" as="geometry"/></mxCell><mxCell id="c187" value="&amp;lt;span style='color:#4C7A5A'&amp;gt;&amp;lt;b&amp;gt;✅ Correct!&amp;lt;/b&amp;gt;&amp;lt;/span&amp;gt;  చాలా బాగుంది" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="2256" y="1612" width="268" height="40" as="geometry"/></mxCell><mxCell id="c188" value="13 · Lesson complete" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="2680" y="1166" width="300" height="28" as="geometry"/></mxCell><mxCell id="c189" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2680" y="1200" width="300" height="600" as="geometry"/></mxCell><mxCell id="c190" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2680" y="1200" width="300" height="8" as="geometry"/></mxCell><mxCell id="c191" value="'Quiz me' opens the game that matches the mode they learned in (orally → Kite, normally → Bridge), using only this lesson's words." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2680" y="1808" width="300" height="120" as="geometry"/></mxCell><mxCell id="c192" value="🎉 small celebration" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="2696" y="1224" width="268" height="110" as="geometry"/></mxCell><mxCell id="c193" value="Lesson done!" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="2696" y="1346" width="268" height="30" as="geometry"/></mxCell><mxCell id="c194" value="పాఠం పూర్తయింది" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2696" y="1376" width="268" height="22" as="geometry"/></mxCell><mxCell id="c195" value="&amp;lt;b&amp;gt;New words&amp;lt;/b&amp;gt;&lt;br&gt;price · cheap · bag · receipt" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="2696" y="1410" width="268" height="60" as="geometry"/></mxCell><mxCell id="c196" value="Accuracy &amp;lt;b&amp;gt;90%&amp;lt;/b&amp;gt;  ·  9 minutes" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="2696" y="1480" width="268" height="42" as="geometry"/></mxCell><mxCell id="c197" value="🎮 Quiz me on this" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2696" y="1540" width="268" height="44" as="geometry"/></mxCell><mxCell id="c198" value="Next lesson →" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="2696" y="1594" width="268" height="38" as="geometry"/></mxCell><mxCell id="c199" value="🏠 Home" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="2696" y="1642" width="268" height="38" as="geometry"/></mxCell><mxCell id="c200" value="14 · Mic check (pop-up)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="2106" width="300" height="28" as="geometry"/></mxCell><mxCell id="c201" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1360" y="2140" width="300" height="600" as="geometry"/></mxCell><mxCell id="c202" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1360" y="2140" width="300" height="8" as="geometry"/></mxCell><mxCell id="c203" value="Shown the first time an oral mode opens, or when the mic is blocked.&lt;br&gt;'Not now' sends them to the matching 'normally' page instead of a dead end." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1360" y="2748" width="300" height="120" as="geometry"/></mxCell><mxCell id="c204" value="(the screen behind is dimmed)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="1376" y="2164" width="268" height="90" as="geometry"/></mxCell><mxCell id="c205" value="🎙&lt;br&gt;&amp;lt;b&amp;gt;Allow microphone&amp;lt;/b&amp;gt;&lt;br&gt;We need your mic to hear you speak.&lt;br&gt;మీ మాట వినడానికి మైక్ అవసరం" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1376" y="2268" width="268" height="120" as="geometry"/></mxCell><mxCell id="c206" value="Say 'hello' to test   ▁▃▅▇▅▃" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="1376" y="2400" width="268" height="44" as="geometry"/></mxCell><mxCell id="c207" value="Allow" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1376" y="2458" width="268" height="44" as="geometry"/></mxCell><mxCell id="c208" value="Not now → use the no-speaking mode" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="1376" y="2512" width="268" height="40" as="geometry"/></mxCell><mxCell id="c209" value="15 · Quiz orally · Kite game 🪁" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1800" y="2106" width="300" height="28" as="geometry"/></mxCell><mxCell id="c210" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1800" y="2140" width="300" height="600" as="geometry"/></mxCell><mxCell id="c211" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1800" y="2140" width="300" height="8" as="geometry"/></mxCell><mxCell id="c212" value="Sankranti kite theme. Say it right (score ≥ 70) and the kite climbs a level. A wrong or weak answer frays one string.&lt;br&gt;3 frayed strings, or 60 s of silence on one prompt, and the string snaps: the kite flies off (fail). Reach the clouds (level 10) to win." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1800" y="2748" width="300" height="120" as="geometry"/></mxCell><mxCell id="c213" value="🧵🧵🧵" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="1816" y="2164" width="90" height="30" as="geometry"/></mxCell><mxCell id="c214" value="⏱ 60" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="1914" y="2164" width="72" height="30" as="geometry"/></mxCell><mxCell id="c215" value="Level 4 / 10" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1994" y="2164" width="90" height="30" as="geometry"/></mxCell><mxCell id="c216" value="☁        ☀        ☁&lt;br&gt;&lt;br&gt;🪁&lt;br&gt;╲&lt;br&gt;  ╲   string&lt;br&gt;    ╲&lt;br&gt;🧍 on the rooftop&lt;br&gt;&lt;br&gt;▮ height meter on the right side" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="1816" y="2202" width="268" height="232" as="geometry"/></mxCell><mxCell id="c217" value="🔊 'శుభోదయం' ఇంగ్లీష్‌లో చెప్పండి&lt;br&gt;&amp;lt;i&amp;gt;Say it in English&amp;lt;/i&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1816" y="2444" width="268" height="60" as="geometry"/></mxCell><mxCell id="c218" value="🎙  Hold and say it" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;arcSize=50;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1816" y="2514" width="268" height="64" as="geometry"/></mxCell><mxCell id="c219" value="Good pronunciation → kite climbs ↑ · Weak → string frays" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1816" y="2586" width="268" height="24" as="geometry"/></mxCell><mxCell id="c220" value="16 · Quiz normally · Bridge game 🌉" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="2240" y="2106" width="300" height="28" as="geometry"/></mxCell><mxCell id="c221" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2240" y="2140" width="300" height="600" as="geometry"/></mxCell><mxCell id="c222" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2240" y="2140" width="300" height="8" as="geometry"/></mxCell><mxCell id="c223" value="Each right answer moves the character one plank forward. 3 wrong answers, or 60 s on one question, and the character falls (fail).&lt;br&gt;Reach the far cliff to win. The 60 s timer resets on each question." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2240" y="2748" width="300" height="120" as="geometry"/></mxCell><mxCell id="c224" value="❤ ❤ ❤" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="2256" y="2164" width="90" height="30" as="geometry"/></mxCell><mxCell id="c225" value="⏱ 60" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="2354" y="2164" width="72" height="30" as="geometry"/></mxCell><mxCell id="c226" value="Step 4 / 10" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2434" y="2164" width="90" height="30" as="geometry"/></mxCell><mxCell id="c227" value="⛰                                   ⛰&lt;br&gt;▭ ▭ ▭ 🧍 ▭ ▭ ▭ ▭ ▭ ▭&lt;br&gt;&lt;br&gt;~ ~ ~  valley far below  ~ ~ ~" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="2256" y="2202" width="268" height="190" as="geometry"/></mxCell><mxCell id="c228" value="'ధర ఎంత?' అంటే ఏమిటి?&lt;br&gt;&amp;lt;i&amp;gt;What does this mean?&amp;lt;/i&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="2256" y="2402" width="268" height="58" as="geometry"/></mxCell><mxCell id="c229" value="How much is it?" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="2256" y="2470" width="268" height="42" as="geometry"/></mxCell><mxCell id="c230" value="Where is it?" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="2256" y="2520" width="268" height="42" as="geometry"/></mxCell><mxCell id="c231" v