<mxfile host="app.diagrams.net"><diagram id="flow" name="Phone"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#F4EEE2" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="1 · Landing (scrolls)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="300" height="28" as="geometry"/></mxCell><mxCell id="c3" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="300" height="1860" as="geometry"/></mxCell><mxCell id="c4" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="300" height="8" as="geometry"/></mxCell><mxCell id="c5" value="A long page that scrolls. The first screen shows the headline, the demo video and Get started; the 'What you can do' cards start just above the fold, so it's clear there's more below.&lt;br&gt;Each mode gets a full-width card in its dashboard tile color. Tapping an accent plays a short sample. Get started, Sign up and the bottom button all go to Sign up." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="2128" width="300" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&amp;lt;b&amp;gt;మాటలు&amp;lt;/b&amp;gt; Maatalu" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="56" y="284" width="104" height="32" as="geometry"/></mxCell><mxCell id="c7" value="Log in" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="168" y="284" width="74" height="32" as="geometry"/></mxCell><mxCell id="c8" value="Sign up" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="284" width="74" height="32" as="geometry"/></mxCell><mxCell id="c9" value="Learn everyday English, explained in Telugu" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="56" y="324" width="268" height="46" as="geometry"/></mxCell><mxCell id="c10" value="రోజువారీ ఇంగ్లీష్, తెలుగులో నేర్చుకోండి" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="372" width="268" height="18" as="geometry"/></mxCell><mxCell id="c11" value="▶  Demo video&lt;br&gt;(how the app works)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="56" y="398" width="167" height="150" as="geometry"/></mxCell><mxCell id="c12" value="Get started →" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="231" y="398" width="93" height="150" as="geometry"/></mxCell><mxCell id="c13" value="                    Scroll to see what you can do ↓" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="562" width="268" height="18" as="geometry"/></mxCell><mxCell id="c14" value="What you can do" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="56" y="596" width="268" height="28" as="geometry"/></mxCell><mxCell id="c15" value="&amp;lt;span style='font-size:17px'&amp;gt;Learn by speaking&amp;lt;/span&amp;gt;&lt;br&gt;&amp;lt;span style='font-size:11px;font-weight:normal'&amp;gt;Hear a phrase in a US voice, say it back, and see a score for every word. A Telugu voice explains each step.&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;fontSize=15;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;align=left;" vertex="1" parent="1"><mxGeometry x="56" y="634" width="268" height="240" as="geometry"/></mxCell><mxCell id="c16" value="🎙  illustration: speaking into the phone, words turning green" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="68" y="646" width="244" height="120" as="geometry"/></mxCell><mxCell id="c17" value="&amp;lt;span style='font-size:17px'&amp;gt;Learn by reading&amp;lt;/span&amp;gt;&lt;br&gt;&amp;lt;span style='font-size:11px;font-weight:normal'&amp;gt;Same lessons with no mic. Put words in order, pick the meaning, fill in blanks. Good for quiet places.&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#4C7A5A;strokeColor=none;fontColor=#F7EFDD;fontStyle=1;fontSize=15;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;align=left;" vertex="1" parent="1"><mxGeometry x="56" y="888" width="268" height="240" as="geometry"/></mxCell><mxCell id="c18" value="📖  illustration: tapping words into order" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="68" y="900" width="244" height="120" as="geometry"/></mxCell><mxCell id="c19" value="&amp;lt;span style='font-size:17px'&amp;gt;Kite game (speak)&amp;lt;/span&amp;gt;&lt;br&gt;&amp;lt;span style='font-size:11px;font-weight:normal'&amp;gt;Say the word right and your kite flies higher. Three misses and the string snaps.&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#A13D3D;strokeColor=none;fontColor=#F7EFDD;fontStyle=1;fontSize=15;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;align=left;" vertex="1" parent="1"><mxGeometry x="56" y="1142" width="268" height="240" as="geometry"/></mxCell><mxCell id="c20" value="🪁  illustration: kite climbing over rooftops" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="68" y="1154" width="244" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&amp;lt;span style='font-size:17px'&amp;gt;Bridge game (tap)&amp;lt;/span&amp;gt;&lt;br&gt;&amp;lt;span style='font-size:11px;font-weight:normal'&amp;gt;Each right answer is one step across the bridge. Three wrong answers or 60 seconds and you fall.&amp;lt;/span&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#2E4470;strokeColor=#C9BFA6;fontColor=#F7EFDD;fontStyle=1;fontSize=15;verticalAlign=bottom;spacingBottom=14;spacingLeft=12;spacingRight=12;align=left;" vertex="1" parent="1"><mxGeometry x="56" y="1396" width="268" height="240" as="geometry"/></mxCell><mxCell id="c22" value="🌉  illustration: character crossing a rope bridge" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="68" y="1408" width="244" height="120" as="geometry"/></mxCell><mxCell id="c23" value="7 English accents" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="56" y="1650" width="268" height="28" as="geometry"/></mxCell><mxCell id="c24" value="Tap one to hear it 🔊 · you can switch any time" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="1682" width="268" height="18" as="geometry"/></mxCell><mxCell id="c25" value="🇺🇸 US" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="56" y="1708" width="130" height="38" as="geometry"/></mxCell><mxCell id="c26" value="🇬🇧 UK" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="194" y="1708" width="130" height="38" as="geometry"/></mxCell><mxCell id="c27" value="🇦🇺 Australia" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="56" y="1754" width="130" height="38" as="geometry"/></mxCell><mxCell id="c28" value="🇮🇳 India" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="194" y="1754" width="130" height="38" as="geometry"/></mxCell><mxCell id="c29" value="🇮🇪 Ireland" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="56" y="1800" width="130" height="38" as="geometry"/></mxCell><mxCell id="c30" value="🇿🇦 South Africa" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="194" y="1800" width="130" height="38" as="geometry"/></mxCell><mxCell id="c31" value="🇳🇬 Nigeria" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="56" y="1846" width="130" height="38" as="geometry"/></mxCell><mxCell id="c32" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="194" y="1846" width="130" height="38" as="geometry"/></mxCell><mxCell id="c33" value="🔊 &amp;lt;b&amp;gt;A Telugu voice guides you the whole way&amp;lt;/b&amp;gt;&lt;br&gt;Instructions and tips are spoken in Telugu." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="56" y="1892" width="268" height="60" as="geometry"/></mxCell><mxCell id="c34" value="Ready to start?" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="56" y="1976" width="268" height="28" as="geometry"/></mxCell><mxCell id="c35" value="Get started" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="2012" width="268" height="46" as="geometry"/></mxCell><mxCell id="c36" value="About · Privacy · Contact" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="56" y="2082" width="268" height="18" as="geometry"/></mxCell><mxCell id="c37" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=#E3A008;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="859" width="340" height="2" as="geometry"/></mxCell><mxCell id="c38" value="◀ phone screen ends here&lt;br&gt;scroll ↓" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#A13D3D;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="364" y="830" width="130" height="60" as="geometry"/></mxCell><mxCell id="c39" value="2 · Sign up" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="920" y="226" width="300" height="28" as="geometry"/></mxCell><mxCell id="c40" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="300" height="600" as="geometry"/></mxCell><mxCell id="c41" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="260" width="300" height="8" as="geometry"/></mxCell><mxCell id="c42" value="Supabase Auth handles email + password. Username goes in a profiles table.&lt;br&gt;A recovery phone needs a paid SMS provider. My suggestion: email only for now (the reset link goes to it), and add the recovery field later if needed." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="920" y="868" width="300" height="120" as="geometry"/></mxCell><mxCell id="c43" value="← Back" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936" y="284" width="268" height="18" as="geometry"/></mxCell><mxCell id="c44" value="Create your account" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="936" y="310" width="268" height="28" as="geometry"/></mxCell><mxCell id="c45" value="మీ ఖాతా తెరవండి" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936" y="338" width="268" height="20" as="geometry"/></mxCell><mxCell id="c46" value="Email  ·  ఈమెయిల్" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#EFE4CD;strokeColor=#C9BFA6;fontColor=#4A4030;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="936" y="366" width="268" height="36" as="geometry"/></mxCell><mxCell id="c47" value="Username  ·  పేరు" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#EFE4CD;strokeColor=#C9BFA6;fontColor=#4A4030;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="936" y="412" width="268" height="36" as="geometry"/></mxCell><mxCell id="c48" value="Password  ·  పాస్‌వర్డ్          👁" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#EFE4CD;strokeColor=#C9BFA6;fontColor=#4A4030;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="936" y="458" width="268" height="36" as="geometry"/></mxCell><mxCell id="c49" value="Recovery email or phone (optional)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#EFE4CD;strokeColor=#C9BFA6;fontColor=#4A4030;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="936" y="504" width="268" height="36" as="geometry"/></mxCell><mxCell id="c50" value="Create account" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="936" y="556" width="268" height="44" as="geometry"/></mxCell><mxCell id="c51" value="                                       or" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="936" y="612" width="268" height="16" as="geometry"/></mxCell><mxCell id="c52" value="Continue with Google" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="936" y="636" width="268" height="38" as="geometry"/></mxCell><mxCell id="c53" value="Already have an account? &amp;lt;u&amp;gt;Log in&amp;lt;/u&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="936" y="686" width="268" height="20" as="geometry"/></mxCell><mxCell id="c54" value="3 · Level check (6 short steps)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1360" y="226" width="300" height="28" as="geometry"/></mxCell><mxCell id="c55" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1360" y="260" width="300" height="600" as="geometry"/></mxCell><mxCell id="c56" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1360" y="260" width="300" height="8" as="geometry"/></mxCell><mxCell id="c57" value="1 Understanding speech (self-rating) · 2 Reading (self-rating) · 3–5 quick checks (picture → word, listen → pick, Telugu → English) · 6 Goals (market, doctor, phone calls, grandkids, travel).&lt;br&gt;Self-rating alone isn't reliable, so mix it with real checks. Every question has a 🔊 Telugu read-aloud." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1360" y="868" width="300" height="120" as="geometry"/></mxCell><mxCell id="c58" value="Step 1 of 6" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1376" y="284" width="113" height="18" as="geometry"/></mxCell><mxCell id="c59" value="Skip – I'm a beginner ›" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1497" y="284" width="147" height="18" as="geometry"/></mxCell><mxCell id="c60" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=50;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1376" y="306" width="268" height="6" as="geometry"/></mxCell><mxCell id="c61" value="🔊&lt;br&gt;ఇంగ్లీష్ మాట్లాడితే మీకు ఎంత అర్థమవుతుంది?&lt;br&gt;&amp;lt;i&amp;gt;How much do you understand when someone speaks English?&amp;lt;/i&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1376" y="324" width="268" height="96" as="geometry"/></mxCell><mxCell id="c62" value="😶  Almost nothing" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="1376" y="434" width="268" height="52" as="geometry"/></mxCell><mxCell id="c63" value="🙂  A few words" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="1376" y="494" width="268" height="52" as="geometry"/></mxCell><mxCell id="c64" value="😊  Simple sentences  ✔" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;strokeColor=#E3A008;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1376" y="554" width="268" height="52" as="geometry"/></mxCell><mxCell id="c65" value="😎  Most things" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex="1" parent="1"><mxGeometry x="1376" y="614" width="268" height="52" as="geometry"/></mxCell><mxCell id="c66" value="Back" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="1376" y="686" width="100" height="42" as="geometry"/></mxCell><mxCell id="c67" value="Next" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1484" y="686" width="160" height="42" as="geometry"/></mxCell><mxCell id="c68" value="4 · Your plan is ready" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1800" y="226" width="300" height="28" as="geometry"/></mxCell><mxCell id="c69" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1800" y="260" width="300" height="600" as="geometry"/></mxCell><mxCell id="c70" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1800" y="260" width="300" height="8" as="geometry"/></mxCell><mxCell id="c71" value="Shows what the level check decided, so the plan feels made for them.&lt;br&gt;The accent defaults from location, with US English for mom. They can change it here or in Settings." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1800" y="868" width="300" height="120" as="geometry"/></mxCell><mxCell id="c72" value="Your plan is ready 🎉" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;fontSize=17;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="1816" y="284" width="268" height="30" as="geometry"/></mxCell><mxCell id="c73" value="మీ కోసం పాఠాలు సిద్ధం" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#C9BFA6;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1816" y="316" width="268" height="20" as="geometry"/></mxCell><mxCell id="c74" value="&amp;lt;b&amp;gt;Level:&amp;lt;/b&amp;gt; Beginner&lt;br&gt;Start with: Greetings → At the market" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1816" y="348" width="268" height="60" as="geometry"/></mxCell><mxCell id="c75" value="&amp;lt;b&amp;gt;12 lessons&amp;lt;/b&amp;gt; · about 10 min a day" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1816" y="418" width="268" height="44" as="geometry"/></mxCell><mxCell id="c76" value="&amp;lt;b&amp;gt;Accent:&amp;lt;/b&amp;gt; 🇺🇸 US English   &amp;lt;u&amp;gt;change&amp;lt;/u&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1816" y="472" width="268" height="44" as="geometry"/></mxCell><mxCell id="c77" value="&amp;lt;b&amp;gt;Guide voice:&amp;lt;/b&amp;gt; Diya (Telugu) 🔊" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#FBF3E4;strokeColor=none;fontColor=#241C10;" vertex="1" parent="1"><mxGeometry x="1816" y="526" width="268" height="44" as="geometry"/></mxCell><mxCell id="c78" value="Small preview of the lesson path" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=8;fillColor=#131F38;strokeColor=#C9BFA6;dashed=1;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="1816" y="580" width="268" height="110" as="geometry"/></mxCell><mxCell id="c79" value="Go to my dashboard →" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=#E3A008;strokeColor=none;fontColor=#131F38;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1816" y="710" width="268" height="46" as="geometry"/></mxCell><mxCell id="c80" value="5 · Dashboard (home)" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="2240" y="226" width="300" height="28" as="geometry"/></mxCell><mxCell id="c81" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2240" y="260" width="300" height="600" as="geometry"/></mxCell><mxCell id="c82" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2240" y="260" width="300" height="8" as="geometry"/></mxCell><mxCell id="c83" value="The four big tiles fill the screen. The two 'normally' tiles say 'No speaking needed', so they're the obvious pick in a quiet place.&lt;br&gt;Continue jumps straight to the current lesson." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E3A008;fontColor=#4A4030;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2240" y="868" width="300" height="120" as="geometry"/></mxCell><mxCell id="c84" value="&amp;lt;b&amp;gt;నమస్తే, Amma 👋&amp;lt;/b&amp;gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#F7EFDD;align=left;" vertex="1" parent="1"><mxGeometry x="2256" y="284" width="160" height="32" as="geometry"/></mxCell><mxCell id="c85" value="🔥 3 days" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="2424" y="284" width="100" height="32" as="geometry"/></mxCell><mxCell id="c86" value="▶  Continue: Lesson 3 · At the market" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=12;fillColor=#EFE4CD;strokeColor=none;fontColor=#4A4030;" vertex=