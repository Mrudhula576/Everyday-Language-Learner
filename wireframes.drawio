117" value="Account: email, password  ›" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=10;fillColor=#EFE4CD;strokeColor=#C9BFA6;fontColor=#4A4030;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="3136" y="639" width="268" height="38" as="geometry"/></mxCell><mxCell id="c118" value="Log out" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=30;fillColor=none;strokeColor=#C9BFA6;fontColor=#F7EFDD;" vertex="1" parent="1"><mxGeometry x="3136" y="684" width="268" height="36" as="geometry"/></mxCell><mxCell id="c119" value="🏠 Home    📈 Progress    &lt;b style='color:#E3A008'&gt;⚙ Settings&lt;/b&gt;" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#131F38;strokeColor=none;fontColor=#C9BFA6;" vertex="1" parent="1"><mxGeometry x="3123" y="810" width="294" height="46" as="geometry"/></mxCell><mxCell id="c120" value="8 · Log in" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;text;fillColor=none;strokeColor=none;fontColor=#241C10;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="480" y="1166" width="300" height="28" as="geometry"/></mxCell><mxCell id="c121" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#1B2A4A;strokeColor=#241C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="480" y="1200" width="300" height="600" as="geometry"/></mxCell><mxCell id="c122" value="" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=0;fillColor=#E3A008;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="480" y="1200" width="300" height="8" as="geometry"/></mxCell><mxCell id="c123" value="Supabase signs in by email. If they type a username, the backend looks up the email first.&lt;br&gt;Stays logged in on the phone, so mom rarely sees this page." style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=12;rounded=1;arcSize=6;fillColor=#FFF8E1;strokeColor=#E